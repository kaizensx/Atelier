{
  "files": {
    "manifest.json": {
      "format": 1,
      "kind": "look",
      "id": "{{id}}",
      "name": "{{name}}",
      "version": "1.0.0",
      "author": "{{author}}",
      "description": "Dark, warm and quiet.",
      "theme": "atelier-theme.json"
    },
    "atelier-theme.json": {
      "format": 1,
      "id": "{{id}}.theme",
      "name": "{{name}}",
      "version": "1.0.0",
      "appearance": "dark",
      "colors": {
        "accent": "#FF8A3D"
      }
    }
  }
}
