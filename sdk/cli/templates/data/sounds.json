{
  "files": {
    "manifest.json": {
      "format": 1,
      "kind": "sounds",
      "id": "{{id}}",
      "name": "{{name}}",
      "version": "1.0.0",
      "author": "{{author}}",
      "description": "Soft sounds for Atelier.",
      "sounds": {
        "dock.click": "sounds/click.aiff"
      }
    },
    "README.md": "Put short .aiff, .wav, .caf or .m4a files in sounds/ and map each Atelier sound to its file in manifest.json.\n"
  }
}
