{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atelier:plugin-manifest:1",
  "title": "Atelier plugin manifest",
  "description": "manifest.json inside a .atelierplugin folder. Generated from docs/plugin-api.json (API 1.1).",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^(\\$|x-)": {}
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Manifest format. Always 1."
    },
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$",
      "description": "Reverse-DNS identifier, unique to the plugin: com.example.pomodoro. Permanent: updates follow it."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Shown in Atelier."
    },
    "version": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version: 1.0.0."
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "description": "Who made it."
    },
    "description": {
      "type": "string",
      "maxLength": 400,
      "description": "What it does, in a sentence or two."
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.js$",
      "description": "The script Atelier runs, a path inside the plugin folder. At most 512 KB.",
      "default": "main.js"
    },
    "icon": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9.]+$",
      "description": "An SF Symbol name for the plugin.",
      "default": "puzzlepiece.extension"
    },
    "homepage": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://",
      "description": "An https link to the plugin's page or source."
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "enum": [
          "network",
          "notifications",
          "openURL",
          "appearance",
          "menuBar",
          "liveActivities",
          "scenes",
          "panels"
        ]
      },
      "description": "What it asks for. The owner grants each one separately."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
          }
        }
      },
      "description": "Hosts the http functions and image views may reach, like api.github.com. No schemes, paths, ports, wildcards, local or private addresses. Required with the network permission."
    },
    "settings": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "type": {
            "enum": [
              "text",
              "secret",
              "number",
              "toggle",
              "choice",
              "color",
              "hotkeyHint"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          },
          "default": {},
          "options": {
            "type": "array",
            "maxItems": 40
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      },
      "description": "Settings Atelier draws for the plugin, on its page in Mods and in its details in Mods › Library. Read and write them with atelier.settings; changes arrive as the settingsChanged event. (Atelier 1.0.0-beta.4)"
    },
    "activation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(onStartup|onCommand|onWidgetVisible|onTileClick|onTimer|onCorner|onEvent:[A-Za-z]+)$"
      },
      "description": "When the script starts. Leave it out to start at launch. Without onStartup the script waits for onCommand, onWidgetVisible, onTileClick, onCorner, onTimer (with contributes.timer) or onEvent:<event>; what contributes declares shows meanwhile. (Atelier 1.0.0-beta.4)"
    },
    "contributes": {
      "type": "object",
      "properties": {
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        },
        "cornerActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        },
        "timer": {
          "type": "number",
          "minimum": 60,
          "maximum": 86400
        }
      },
      "description": "What shows before the script runs, with activation: widgets, tiles (id, title, symbol), commands and corner actions, checked like registrations; timer is how often onTimer wakes it, in seconds. The script must still register them with the same ids. (Atelier 1.0.0-beta.4)"
    },
    "strings": {
      "type": "object",
      "maxProperties": 24,
      "description": "Localized text for atelier.t, by language code: { \"en\": { \"hello\": \"Hello\" }, \"pt\": { \"hello\": \"Olá\" } }. Up to 24 languages and 400 keys each, values up to 1000 characters. (Atelier 1.0.0-beta.4)"
    },
    "messages": {
      "type": "object",
      "properties": {
        "send": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "receive": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "description": "Plugin ids this one may send to and hear from. A message is delivered only when the sender lists the receiver under send and the receiver lists the sender under receive. (Atelier 1.0.0-beta.4)"
    }
  }
}
